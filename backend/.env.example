# Copy file này thành backend/.env rồi chỉnh nếu cần. KHÔNG commit file .env.

# Cổng chạy server (Render tự cấp PORT)
PORT=3000

# PostgreSQL. Giá trị dưới khớp với docker-compose.yml ở thư mục gốc (docker compose up -d db).
DATABASE_URL=postgres://next:next@localhost:5432/next3
# Bật SSL khi nối database cloud từ ngoài (Neon, Supabase, Render External URL...). Máy dev để false.
DATABASE_SSL=false
# Tự chạy migration khi server khởi động.
DB_RUN_MIGRATIONS=true

# Khóa ký JWT. Dev có thể bỏ trống (dùng khóa mặc định), production BẮT BUỘC đặt chuỗi ngẫu nhiên >= 32 ký tự.
# Tạo nhanh: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Access token sống 15 phút, refresh token sống 30 ngày.
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Tạo sẵn tài khoản demo kèm vài task để thử Top 3 trên Swagger.
SEED_DEMO_DATA=true
DEMO_EMAIL=demo@3next.app
DEMO_PASSWORD=demo12345

# Database RIÊNG cho test e2e (npm test xóa sạch dữ liệu trong đó). Tên database phải chứa chữ "test".
# Bỏ trống thì test e2e được bỏ qua, chỉ chạy unit test.
TEST_DATABASE_URL=postgres://next:next@localhost:5432/next3_test
